{
  "name": "@lzwme/sserver",
  "version": "0.0.11",
  "description": "一个基于 Node.js 的简易静态服务器，用于辅助开发调试随启随用",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "sserver": "bin/sserver.js",
    "ss": "bin/sserver.js"
  },
  "repository": "https://github.com/lzwme/static-server.git",
  "author": {
    "name": "renxia",
    "email": "lzwy0820@qq.com",
    "url": "https://lzw.me"
  },
  "license": "MIT",
  "private": false,
  "engines": {
    "node": "^14.18.0 || >=16.15.0"
  },
  "keywords": [
    "server",
    "web-server",
    "static-server",
    "proxy-server"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "files": [
    "dist",
    "ss.config.sample.js"
  ],
  "scripts": {
    "ss": "node bin/sserver.js",
    "start": "npm run stop && pm2 start dist/index.js --name sserver",
    "stop": "pm2 stop sserver",
    "watch": "tsc -w",
    "lint": "biome check",
    "fix": "biome check --fix",
    "dev": "bun run src/cli.ts",
    "dev:watch": "bun --watch src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run clean && npm run build:assets && tsc && node scripts/copy-assets.js",
    "build:assets": "npm run build:css && npm run build:vendor",
    "build:css": "tailwindcss -i src/localsend/input.css -o src/localsend/style.css --minify",
    "build:vendor": "node scripts/copy-vendor.js",
    "clean": "flh rm -f dist",
    "version": "standard-version",
    "release": "npm run build"
  },
  "dependencies": {
    "@lzwme/fe-utils": "^1.9.2",
    "commander": "^15.1.0",
    "console-log-colors": "^0.5.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.2",
    "multer": "^2.5.0",
    "node-forge": "^1.4.3",
    "serve-index": "^1.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@lzwme/fed-lint-helper": "^2.6.6",
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "husky": "^9.1.7",
    "qr-code-styling": "^1.9.2",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
